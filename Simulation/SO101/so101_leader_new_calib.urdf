  <!-- Joint from gripper to leader trigger -->
  <joint name="gripper" type="revolute">
    <!-- Provisional 0..45 degree trigger travel; positive opens. Retains original servo-axis frame. Verify zero/range on your leader. -->
    <origin xyz="0.0202 0.0188 -0.0234" rpy="1.5708 -5.24284e-08 -1.41553e-15"/>
    <parent link="gripper_link"/>
    <child link="trigger_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="10" lower="0" upper="0.785398163397"/>
  </joint>
  <transmission name="gripper_trans">
    <type>transmission_interface/SimpleTransmission</type>
